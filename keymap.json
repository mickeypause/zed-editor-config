// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "cmd-b": "workspace::ToggleRightDock",
      "cmd-i": "workspace::ToggleLeftDock",
      "cmd-r": null,
      "cmd-w": null,
      "cmd-shift-w": null,
      "cmd-r w": "menu::Cancel"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-w": null,
      "cmd-r w": "pane::CloseInactiveItems"
    }
  },
  {
    "context": "EmptyPane",
    "bindings": {
      "cmd-w": null,
      "cmd-r w": "menu::Cancel"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-escape": "editor::ShowCompletions",
      "cmd-i": "workspace::ToggleLeftDock",
      "cmd-r w": "pane::CloseInactiveItems",
      "cmd-w": null
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-i": "workspace::ToggleLeftDock",
      "cmd-b": null
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "cmd-i": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-i": "workspace::ToggleLeftDock"
    }
  },
]
